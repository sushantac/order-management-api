<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================================
  PR #2 - Database Schema with Foreign Keys

  Liquibase changelog master: the single entry point for every schema change.
  Golden rules taught here:
    1. NEVER edit a changeset that has already run in any environment - the
       stored checksum would mismatch and Liquibase refuses to start.
       Add a NEW changeset (or a new included file) instead.
    2. Every environment (dev/CI/prod) gets the schema from this file, so the
       database is always reproducible from git. That is the DB part of GitOps.
  ============================================================================
-->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      relativeToChangelogFile: resolve "v1.0/..." against THIS file's folder
      (db/changelog), i.e. db/changelog/v1.0/01_create_tables.sql on the classpath.
    -->
    <include file="v1.0/01_create_tables.sql" relativeToChangelogFile="true"/>
    <!-- PR #8: optimistic locking needs a version column on every table. -->
    <include file="v1.0/02_add_version_columns.sql" relativeToChangelogFile="true"/>
    <!-- PR #10: auditing columns on every entity table. -->
    <include file="v1.0/03_add_audit_columns.sql" relativeToChangelogFile="true"/>
    <!-- PR #13: order_number populated by a @PrePersist callback. -->
    <include file="v1.0/04_add_order_number.sql" relativeToChangelogFile="true"/>
    <!-- PR #19: append-only event store for event sourcing. -->
    <include file="v1.0/05_create_event_store.sql" relativeToChangelogFile="true"/>
    <!-- PR #24: idempotency keys for safe retries of writes. -->
    <include file="v1.0/06_create_idempotency_keys.sql" relativeToChangelogFile="true"/>
    <!-- PR #27: compliance audit trail for GDPR subject-rights actions. -->
    <include file="v1.0/07_create_audit_log.sql" relativeToChangelogFile="true"/>
    <!-- PR #31: transactional outbox for reliable Kafka publishing. -->
    <include file="v1.0/08_create_outbox.sql" relativeToChangelogFile="true"/>
    <!-- PR #48: MCP tool invocation audit trail. -->
    <include file="v1.0/09_create_mcp_tool_audit.sql" relativeToChangelogFile="true"/>

</databaseChangeLog>
