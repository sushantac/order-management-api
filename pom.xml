<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================================
  PR #1 - Project Setup
  Aspect learned: Spring Boot project structure and dependency management.

  Key decisions:
  1. Spring Boot 3.4.1 is pinned (upgraded from 3.2.1 in PR #37 so the official
     MCP Spring SDK can be adopted - it needs Spring Framework 6.2+). Spring
     Boot's parent POM manages dependency versions ("starter" BOM), so we never
     hard-code third-party versions and stay upgrade-safe.
  2. Java 21 LTS is the language/bytecode target (records, pattern matching,
     virtual threads in later PRs). `maven.compiler.release` guarantees Java
     21 bytecode even when a newer JDK is installed on the dev machine.
  3. Only the core starters needed for a JPA/REST project are added now.
     PostgreSQL + Liquibase jars are already on the classpath because the
     very next PRs need them (PR #2 schema + docker-compose, PR #3 entities).
     The application.yml excludes DB auto-configuration until PR #2, so the
     app still boots/tests without a running database.
  4. Deliberately NO Lombok - per coding standards we prefer plain Java.
  5. The Maven wrapper (mvnw) pins the exact Maven version for every
     contributor/CI machine - no local Maven install required.
  ============================================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      Spring Boot parent: brings dependency management + plugin versions.
      PR #37: 3.2.1 -> 3.4.1 so we can adopt the official MCP Java SDK Spring
      transports (mcp-spring-webmvc 0.18.4 compiles against Spring Framework
      6.2.1, which is exactly what Spring Boot 3.4.1 manages). Spring 6.2 is
      the minimum for the MCP Spring modules.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.1</version>
        <relativePath/>
    </parent>

    <groupId>com.company</groupId>
    <artifactId>order-management-api</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>order-management-api</name>
    <description>Production-grade Order Management API - one PR at a time</description>

    <properties>
        <!-- Java 21 LTS: language level AND bytecode target for the whole build. -->
        <java.version>21</java.version>
        <!-- Force Java 21 bytecode even when compiling with a newer local JDK. -->
        <maven.compiler.release>21</maven.compiler.release>
        <!--
          Testcontainers override: Spring Boot 3.2.1 manages 1.19.3, which cannot
          discover Docker Desktop's current socket (~/.docker/run/docker.sock,
          introduced in newer Docker Desktop releases). 1.21.x locates the daemon
          correctly while keeping the same public API.
        -->
        <testcontainers.version>1.21.4</testcontainers.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- Web: REST controllers, embedded Tomcat, JSON via Jackson. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
          JPA: Hibernate + Spring Data JPA. The heart of the learning journey
          (foreign keys, cascading, fetch strategies, locking from PR #3 on).
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Bean Validation (jakarta.validation) - used from PR #23 on. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
          PR #8 - Spring AOP + Spring Retry for @Retryable/@Backoff.
          starter-aop provides the proxy infrastructure; spring-retry provides
          the annotation-driven retry template.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!--
          PR #26 - OAuth2 resource server (JWT bearer tokens). Provides the
          JwtDecoder + filter chain; tokens are issued by an authorization
          server (here simulated with a local HS256 signing secret for the
          learning journey - production uses an issuer's asymmetric keyset).
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.retry</groupId>
            <artifactId>spring-retry</artifactId>
        </dependency>

        <!--
          PR #16 - Hibernate second-level cache via JCache (Ehcache provider).
          hibernate-jcache is the Hibernate integration; org.ehcache is the
          javax.cache provider implementation (version managed by Spring Boot).
        -->
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-jcache</artifactId>
        </dependency>
        <dependency>
            <groupId>org.ehcache</groupId>
            <artifactId>ehcache</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
          PR #28 - Redis client (Lettuce) for the application-level cache.
          @EnableCaching + @Cacheable/@CacheEvict on the product read/write paths;
          Redis is activated per-profile (dev/prod) or by setting
          SPRING_CACHE_TYPE=redis. The DEFAULT profile keeps 'simple'
          (in-memory) so unit/integration tests need no Redis.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!--
          PR #29 - Resilience4j: circuit breaker + retry + bulkhead around the
          payment gateway, and rate limiting per API key. resilience4j-spring-boot3
          auto-configures the registries from the resilience4j.* properties;
          spring-boot-starter-aop is required by Resilience4j's annotations
          (and the existing Spring Retry support).
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-spring-boot3</artifactId>
            <version>2.2.0</version>
        </dependency>

        <!--
          PR #30 - Redisson: distributed locks on Redis. Plain 'redisson' (not
          the spring-boot starter) so it never fights Spring Data Redis/Lettuce
          for the connection factory; we build the client ourselves in
          RedissonConfig and consume it only via DistributedLockService.
        -->
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson</artifactId>
            <version>3.27.2</version>
        </dependency>

        <!--
          PR #31 - Spring for Apache Kafka: outbox publisher (KafkaTemplate),
          order-event listener (@KafkaListener, manual ack) and DLT handling.
          Only activated when app.kafka.enabled=true (see messaging classes);
          the outbox TABLE is written on every order in ALL profiles.
        -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          PR #36/37 - Model Context Protocol (AI assistant tools).
          Official MCP Java SDK Spring integration (io.modelcontextprotocol.sdk).
          mcp-spring-webmvc provides the Streamable-HTTP stateless transport and
          REQUIRES Spring Framework 6.2.1+ (why Boot was upgraded to 3.4.1 in
          PR #37). mcp-json-jackson2 bridges the SDK's JSON SPI to Jackson 2 so
          the transport reuses the Spring-managed ObjectMapper. mcp-core (server
          + client, JDK-HTTP transports) comes in transitively.
        -->
        <dependency>
            <groupId>io.modelcontextprotocol.sdk</groupId>
            <artifactId>mcp-spring-webmvc</artifactId>
            <version>0.18.4</version>
        </dependency>
        <dependency>
            <groupId>io.modelcontextprotocol.sdk</groupId>
            <artifactId>mcp-json-jackson2</artifactId>
            <version>0.18.4</version>
        </dependency>

        <!--
          PR #25 - OpenAPI / Swagger UI. Generates the machine-readable spec at
          /v3/api-docs and serves the UI at /swagger-ui.html. 2.7.0 is the
          springdoc line compatible with Spring Boot 3.4 (2.3.0 returned 500 on
          /v3/api-docs after the PR #37 Boot upgrade).
        -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.7.0</version>
        </dependency>

        <!-- Actuator: /actuator/health etc. for local dev and later K8s probes. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!--
          PR #32 - Observability:
          - micrometer-registry-prometheus exposes /actuator/prometheus,
          - micrometer-tracing-bridge-otel + opentelemetry-exporter-otlp send
            traces to Jaeger/OTLP (activated via management.tracing.enabled),
          - logstash-logback-encoder renders structured JSON logs (prod profile).
        -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>7.4</version>
        </dependency>

        <!-- Liquibase: schema versioning. Changelogs arrive in PR #2. -->
        <dependency>
            <groupId>org.liquibase</groupId>
            <artifactId>liquibase-core</artifactId>
        </dependency>

        <!-- PostgreSQL driver (runtime only - never compile against JDBC driver). -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Test: JUnit 5, Mockito, AssertJ, Spring Test / MockMvc. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- PR #26 - test support for Spring Security (@WithMockJwt etc.). -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          Testcontainers: real-PostgreSQL integration tests without a local
          install. @ServiceConnection (spring-boot-testcontainers) feeds the
          container's JDBC URL straight into Spring Boot's auto-configuration.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Package as an executable jar + run `mvn spring-boot:run`. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
